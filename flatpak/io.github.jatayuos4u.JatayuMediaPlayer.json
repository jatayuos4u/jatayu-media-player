{
  "id": "io.github.jatayuos4u.JatayuMediaPlayer",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "jatayu-media-player",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=home",
    "--filesystem=/media",
    "--filesystem=/run/media"
  ],
  "modules": [
    "libmpv.json",
    {
      "name": "jatayu-media-player",
      "buildsystem": "cmake-ninja",
      "builddir": true,
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_TESTING=OFF"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ],
      "post-install": [
        "mv /app/share/applications/jatayu-media-player.desktop /app/share/applications/io.github.jatayuos4u.JatayuMediaPlayer.desktop",
        "sed -i 's/^Icon=jatayu-media-player$/Icon=io.github.jatayuos4u.JatayuMediaPlayer/' /app/share/applications/io.github.jatayuos4u.JatayuMediaPlayer.desktop",
        "mv /app/share/icons/hicolor/scalable/apps/jatayu-media-player.svg /app/share/icons/hicolor/scalable/apps/io.github.jatayuos4u.JatayuMediaPlayer.svg",
        "install -Dm644 ../flatpak/io.github.jatayuos4u.JatayuMediaPlayer.metainfo.xml /app/share/metainfo/io.github.jatayuos4u.JatayuMediaPlayer.metainfo.xml"
      ]
    }
  ]
}
